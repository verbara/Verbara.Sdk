<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <NoWarn>CA1707</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="coverlet.collector" />
    <!--
      Roslyn parser + compiler used to compile every \`\`\`csharp block extracted
      from README.md / docs/README-technical.md / docs/guides/*.md. Same version
      as Verbara.Sdk.Ami.SourceGenerators consumes (CPM in Directory.Packages.props).
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="System.Reactive" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Reference every shippable Verbara.Sdk.* package whose API surface may
      appear in a documentation snippet. The DocSnippets guard compiles each
      extracted snippet against these references; if a snippet calls a method
      or names a type that no longer exists, the build fails.
    -->
    <ProjectReference Include="..\..\src\Verbara.Sdk\Verbara.Sdk.csproj" />
    <ProjectReference Include="..\..\src\Verbara.Sdk.Hosting\Verbara.Sdk.Hosting.csproj" />
    <ProjectReference Include="..\..\src\Verbara.Sdk.Ami\Verbara.Sdk.Ami.csproj" />
    <ProjectReference Include="..\..\src\Verbara.Sdk.Agi\Verbara.Sdk.Agi.csproj" />
    <ProjectReference Include="..\..\src\Verbara.Sdk.Ari\Verbara.Sdk.Ari.csproj" />
    <ProjectReference Include="..\..\src\Verbara.Sdk.Live\Verbara.Sdk.Live.csproj" />
    <ProjectReference Include="..\..\src\Verbara.Sdk.Activities\Verbara.Sdk.Activities.csproj" />
    <ProjectReference Include="..\..\src\Verbara.Sdk.Sessions\Verbara.Sdk.Sessions.csproj" />
    <ProjectReference Include="..\..\src\Verbara.Sdk.Config\Verbara.Sdk.Config.csproj" />
    <ProjectReference Include="..\..\src\Verbara.Sdk.OpenTelemetry\Verbara.Sdk.OpenTelemetry.csproj" />
    <ProjectReference Include="..\..\src\Verbara.Sdk.Push\Verbara.Sdk.Push.csproj" />
    <ProjectReference Include="..\..\src\Verbara.Sdk.Push.AspNetCore\Verbara.Sdk.Push.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\Verbara.Sdk.Push.Webhooks\Verbara.Sdk.Push.Webhooks.csproj" />
    <ProjectReference Include="..\..\src\Verbara.Sdk.Push.Nats\Verbara.Sdk.Push.Nats.csproj" />
    <ProjectReference Include="..\..\src\Verbara.Sdk.Sessions.Redis\Verbara.Sdk.Sessions.Redis.csproj" />
    <ProjectReference Include="..\..\src\Verbara.Sdk.Sessions.Postgres\Verbara.Sdk.Sessions.Postgres.csproj" />
    <ProjectReference Include="..\..\src\Verbara.Sdk.Audio\Verbara.Sdk.Audio.csproj" />
    <ProjectReference Include="..\..\src\Verbara.Sdk.VoiceAi\Verbara.Sdk.VoiceAi.csproj" />
    <ProjectReference Include="..\..\src\Verbara.Sdk.VoiceAi.Stt\Verbara.Sdk.VoiceAi.Stt.csproj" />
    <ProjectReference Include="..\..\src\Verbara.Sdk.VoiceAi.Tts\Verbara.Sdk.VoiceAi.Tts.csproj" />
    <ProjectReference Include="..\..\src\Verbara.Sdk.VoiceAi.AudioSocket\Verbara.Sdk.VoiceAi.AudioSocket.csproj" />
    <ProjectReference Include="..\..\src\Verbara.Sdk.VoiceAi.OpenAiRealtime\Verbara.Sdk.VoiceAi.OpenAiRealtime.csproj" />
    <ProjectReference Include="..\..\src\Verbara.Sdk.VoiceAi.TurnDetection\Verbara.Sdk.VoiceAi.TurnDetection.csproj" />
    <ProjectReference Include="..\..\src\Verbara.Sdk.Resilience\Verbara.Sdk.Resilience.csproj" />
    <ProjectReference Include="..\..\src\Verbara.Sdk.Cluster.Primitives\Verbara.Sdk.Cluster.Primitives.csproj" />
    <ProjectReference Include="..\..\src\Verbara.Sdk.Cluster.Postgres\Verbara.Sdk.Cluster.Postgres.csproj" />
    <ProjectReference Include="..\..\src\Verbara.Sdk.Data.Npgsql\Verbara.Sdk.Data.Npgsql.csproj" />
  </ItemGroup>
</Project>
