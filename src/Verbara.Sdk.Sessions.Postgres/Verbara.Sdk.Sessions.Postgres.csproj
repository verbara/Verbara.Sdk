<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Verbara.Sdk.Sessions.Postgres - Postgres-backed SessionStoreBase for multi-instance deployments. Ships PostgresSessionStore + fluent UsePostgres(...) registration for Verbara.Sdk.Sessions. AOT-safe (source-generated JSON only, Dapper parameterized SQL).</Description>
    <PackageTags>asterisk;sessions;postgres;postgresql;state-store;sdk</PackageTags>
    <!-- New package - no baseline published yet; skip binary compatibility check -->
    <EnablePackageValidation>false</EnablePackageValidation>
    <InterceptorsPreviewNamespaces>$(InterceptorsPreviewNamespaces);Dapper.AOT</InterceptorsPreviewNamespaces>
    <!-- ADR-0022 Phase D canary: Verbara.Sdk.Dapper.Stubs annotates Dapper call sites with
         [RequiresUnreferencedCode] + [RequiresDynamicCode] so unintercepted sites trip
         IL2026/IL3050 at build time when consumers are IsAotCompatible=true. Dapper.AOT
         1.0.52 does NOT intercept the `new CommandDefinition(...)` overload (upstream PR
         #153 unmerged); PostgresSessionStore.cs uses that overload in 6 of 6 sites.
         Suppression is SCOPED to this assembly and is the canonical Phase D.3 marker:
         the entries below MUST be removed once PostgresSessionStore is refactored to
         either NpgsqlCommand raw or simple-shape conn.X<T>(sql, params, ct) calls per
         the Phase D.3 decision matrix. -->
    <NoWarn>$(NoWarn);IL2026;IL3050</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Verbara.Sdk.Sessions.Postgres.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Verbara.Sdk.Sessions\Verbara.Sdk.Sessions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Verbara.Sdk.Dapper.Stubs" />
    <PackageReference Include="Dapper.AOT" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Migrations\*.sql" Pack="true" PackagePath="contentFiles\any\any\Migrations\" />
    <None Include="Migrations\*.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
