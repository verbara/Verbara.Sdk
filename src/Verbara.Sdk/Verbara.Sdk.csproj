<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Verbara.Sdk - Core abstractions, interfaces, attributes, enums and base types for the Verbara Sdk packages</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- EventActionOutcome lives here, its setters internal: only the AMI connection writes how an action ended, so no
         caller can forge an outcome. -->
    <InternalsVisibleTo Include="Verbara.Sdk.Ami" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
