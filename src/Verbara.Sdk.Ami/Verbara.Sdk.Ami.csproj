<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Asterisk Manager Interface (AMI) client - actions, events, responses and protocol handling</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Verbara.Sdk.Ami.Tests" />
    <InternalsVisibleTo Include="Verbara.Sdk.Benchmarks" />
    <InternalsVisibleTo Include="Verbara.Sdk.FunctionalTests" />
    <InternalsVisibleTo Include="Verbara.Sdk.Sessions.FunctionalTests" />
    <!-- Verbara.Sdk.Live's load of live state calls AmiConnection.FullyBooted, the SendEventGeneratingActionAsync
         overload that takes an EventActionOutcome, and EventActionOutcome's constructor, Rejection and SessionEnded,
         to tell a refusal from an Asterisk still loading its modules, or an action whose session ended, from an empty
         answer. Its OriginateAsync calls the overload that also takes a TimeSpan, to wait for the outcome as long as
         the originate's own Timeout lets the destination ring. VerbaraServer raises its public ConnectionLost from AmiConnection.Lost, the reader loop's announcement of
         a loss nobody asked for, which a patch could not add as public API. Those members keep their signatures until
         3.0, because a Live package of the 2.x line runs on any newer Ami: NuGet resolves Live's dependency on Ami as a
         minimum version, and package validation does not see internal members.
         Tests/Verbara.Sdk.Ami.Tests/Connection/AmiInternalsUsedByLiveTests.cs pins them. -->
    <InternalsVisibleTo Include="Verbara.Sdk.Live" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Verbara.Sdk\Verbara.Sdk.csproj" />
    <ProjectReference Include="..\Verbara.Sdk.Resilience\Verbara.Sdk.Resilience.csproj" />
    <ProjectReference Include="..\Verbara.Sdk.Ami.SourceGenerators\Verbara.Sdk.Ami.SourceGenerators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <!-- System.IO.Pipelines is part of net10.0 shared framework -->
    <PackageReference Include="System.Reactive" />
  </ItemGroup>

</Project>
