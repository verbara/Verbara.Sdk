<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Asterisk REST Interface (ARI) client - HTTP + WebSocket for Stasis applications</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Verbara.Sdk.Ari.Tests" />
    <InternalsVisibleTo Include="Verbara.Sdk.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Verbara.Sdk\Verbara.Sdk.csproj" />
    <ProjectReference Include="..\Verbara.Sdk.Resilience\Verbara.Sdk.Resilience.csproj" />
    <!-- Build-time only: suppresses the chan_websocket deprecation id in the System.Text.Json generator's output
         alone, where the shipped [JsonSerializable] rows name deprecated members and no pragma can go. Never packed. -->
    <ProjectReference Include="..\..\tools\Verbara.Sdk.BuildAnalyzers\Verbara.Sdk.BuildAnalyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="System.Reactive" />
  </ItemGroup>

</Project>
