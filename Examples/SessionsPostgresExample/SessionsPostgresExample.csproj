<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- ADR-0022 Phase D: Dapper.AOT interceptor support + IL2026/IL3050 suppression
         (false positives — analyzer doesn't track interceptor replacement). -->
    <InterceptorsPreviewNamespaces>$(InterceptorsPreviewNamespaces);Dapper.AOT</InterceptorsPreviewNamespaces>
    <NoWarn>$(NoWarn);IL2026;IL3050</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Verbara.Sdk.Hosting\Verbara.Sdk.Hosting.csproj" />
    <ProjectReference Include="..\..\src\Verbara.Sdk.Sessions.Postgres\Verbara.Sdk.Sessions.Postgres.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Dapper comes transitively via Sessions.Postgres → Verbara.Sdk.Dapper.Stubs. -->
    <PackageReference Include="Dapper.AOT" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>
</Project>
