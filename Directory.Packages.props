<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Lets a PackageVersion below govern a package we never reference directly, so a
         vulnerable transitive can be lifted without adding a fake direct dependency to
         every affected project. See the transitive-pin override block at the end. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Runtime dependencies -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.10" />
    <!-- Test-only: in-process ASP.NET Core HTTP pipeline (no port binding) for webhook integration tests. -->
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.0" />
    <!-- System.IO.Pipelines is included in net10.0, no NuGet needed -->
    <PackageVersion Include="System.Reactive" Version="7.0.0" />
  </ItemGroup>

  <!-- Serilog (Dashboard only — SDK uses pure LoggerMessage) -->
  <ItemGroup>
    <PackageVersion Include="Serilog" Version="4.2.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="9.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageVersion Include="Serilog.Expressions" Version="5.0.0" />
  </ItemGroup>

  <!-- Database dependencies -->
  <ItemGroup>
    <PackageVersion Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <!-- Redis (spike validation) -->
  <ItemGroup>
    <PackageVersion Include="StackExchange.Redis" Version="3.1.13" />
  </ItemGroup>

  <!-- NATS (Verbara.Sdk.Push.Nats bridge) -->
  <ItemGroup>
    <PackageVersion Include="NATS.Client.Core" Version="3.1.0" />
    <PackageVersion Include="NATS.Client.Hosting" Version="2.7.3" />
  </ItemGroup>

  <!-- ONNX Runtime (Verbara.Sdk.VoiceAi.TurnDetection) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.28.0" />
  </ItemGroup>

  <!-- OpenTelemetry (Verbara.Sdk.OpenTelemetry batteries-included package) -->
  <ItemGroup>
    <PackageVersion Include="OpenTelemetry" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.Console" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.15.2-beta.1" />
  </ItemGroup>

  <!-- Source generators -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.6.0" />
  </ItemGroup>

  <!-- SourceLink — debuggable NuGet packages -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.301" />
  </ItemGroup>

  <!-- Analyzers — Layer 1: API Protection -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
  </ItemGroup>

  <!-- Analyzers — Layer 2: Compile-Time Bug Detection -->
  <ItemGroup>
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.141" />
    <PackageVersion Include="IDisposableAnalyzers" Version="4.0.8" />
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.7.23" />
    <PackageVersion Include="xunit.analyzers" Version="1.27.0" />
    <PackageVersion Include="NSubstitute.Analyzers.CSharp" Version="1.0.17" />
  </ItemGroup>

  <!-- Layer 3: Test Quality -->
  <ItemGroup>
    <PackageVersion Include="Verify.Xunit" Version="28.8.1" />
    <PackageVersion Include="CsCheck" Version="4.5.0" />
  </ItemGroup>

  <!-- Test dependencies -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="NSubstitute" Version="6.0.0" />
    <PackageVersion Include="FluentAssertions" Version="7.2.2" />
    <PackageVersion Include="bunit" Version="2.0.66" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Testcontainers" Version="4.13.0" />
    <!-- Test-only HTTP substrate for the VoiceAi provider suites whose transport is HTTP
         request/response (ADR-0041 D1/D7). Referenced ONLY from
         Tests/Verbara.Sdk.TestInfrastructure.Http — NOT from Tests/Verbara.Sdk.TestInfrastructure,
         and that distinction is load-bearing: WireMock pulls ASP.NET Core, so any referencing
         project gains a FrameworkReference to Microsoft.AspNetCore.App, the ~30
         Microsoft.Extensions.* assemblies stop being copied to the output directory, and coverlet's
         Cecil resolver then silently skips instrumenting every module that needs them. Reaching
         FunctionalTests/IntegrationTests that way dropped measured coverage 80.42% -> 61.96% with
         every test still green. No src/** project references it and no produced .nupkg declares it.
         Apache-2.0 — clears dependency-review's AGPL/GPL/SSPL deny-list. The full metapackage is
         deliberate over WireMock.Net.Minimal: "Minimal" pulls OpenApiParser/NSwag and resolves
         Newtonsoft.Json 9.0.1 and System.Text.Encodings.Web 4.7.1, both carrying advisories that
         would trip dependency-review's fail-on-severity: high. -->
    <PackageVersion Include="WireMock.Net" Version="2.13.0" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.51.0" />
    <PackageVersion Include="System.Reflection.MetadataLoadContext" Version="10.0.0" />
  </ItemGroup>

  <!-- Benchmark dependencies -->
  <ItemGroup>
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <!-- Transitive-pin overrides (CentralPackageTransitivePinningEnabled=true).
       Packages nothing here references directly, lifted off a vulnerable version. -->
  <ItemGroup>
    <!-- Testcontainers pulls SSH.NET transitively into all 8 container-backed test projects.
         2025.1.0 carries GHSA-q939-rpr3-3284 — a HIGH (CVSS 7.1) arbitrary-file-write via
         server-controlled filenames in ScpClient's recursive download. 2026.0.0 is the first
         patched release. Testcontainers 4.13.0 (latest) still depends on 2025.1.0, so upgrading
         it does not clear the advisory — the pin is the only fix. Real exposure is nil: SSH.NET
         is loaded only for Testcontainers' host-port forwarding, which no suite here uses. But
         NuGet audit (NU1903) correctly escalates it to a build error under TWAE. Advisory drift —
         published 2026-08-12, after the last green main run; every .NET repo went red on it. -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

</Project>
