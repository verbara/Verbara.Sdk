<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Lets a PackageVersion below govern a package a project only reaches transitively: it is
         what runs a test project on the Microsoft.Extensions.* patch even where the package
         arrives only through a src/** reference, and it lifts a vulnerable transitive without
         adding a fake direct dependency to every affected project. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Microsoft.Extensions.* band. A shipped package (IsPackable, which Directory.Build.props sets
       for src/**) declares the band's floor, major.minor.0, in its nuspec instead of the monthly
       servicing patch. A declared ">= 10.0.<patch>" put every consumer that pins an earlier patch
       centrally into NU1109 (package downgrade) on each SDK release; which patch runs is the
       application's choice, and NuGetAudit warns the application when that version carries an
       advisory. Every other project (tests, examples, tools) compiles and runs against the patch.
       MicrosoftExtensionsVersion is the one literal to bump: the floor is derived from it. A shipped
       package whose own dependencies require more than the floor raises it in its project file
       (MicrosoftExtensionsFloorVersion): the Update below is expanded with the project's final
       property values, and a central pin, transitive pins included, below a dependency's minimum is
       NU1109 in this build. -->
  <PropertyGroup>
    <MicrosoftExtensionsVersion>10.0.12</MicrosoftExtensionsVersion>
    <MicrosoftExtensionsFloorVersion>$([System.Version]::Parse('$(MicrosoftExtensionsVersion)').ToString(2)).0</MicrosoftExtensionsFloorVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="$(MicrosoftExtensionsVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <!-- Selects the items just declared: the only PackageVersion items evaluated so far. -->
    <PackageVersion Update="@(PackageVersion->WithMetadataValue('Version', '$(MicrosoftExtensionsVersion)'))" Version="$(MicrosoftExtensionsFloorVersion)" />
  </ItemGroup>

  <!-- Runtime dependencies -->
  <ItemGroup>
    <!-- Test-only: in-process ASP.NET Core HTTP pipeline (no port binding) for webhook integration tests. -->
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.12" />
    <!-- Test-only: real JwtBearer authentication in the SSE push stream tests (tokens minted per test host). -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <!-- System.IO.Pipelines is included in net10.0, no NuGet needed -->
    <PackageVersion Include="System.Reactive" Version="7.0.0" />
  </ItemGroup>

  <!-- Database dependencies -->
  <ItemGroup>
    <PackageVersion Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <!-- Redis (spike validation) -->
  <ItemGroup>
    <PackageVersion Include="StackExchange.Redis" Version="3.3.1" />
  </ItemGroup>

  <!-- NATS (Verbara.Sdk.Push.Nats bridge) -->
  <ItemGroup>
    <PackageVersion Include="NATS.Client.Core" Version="3.3.0" />
  </ItemGroup>

  <!-- ONNX Runtime (Verbara.Sdk.VoiceAi.TurnDetection) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
  </ItemGroup>

  <!-- OpenTelemetry (Verbara.Sdk.OpenTelemetry batteries-included package) -->
  <ItemGroup>
    <PackageVersion Include="OpenTelemetry" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.Console" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.19.1-beta.1" />
  </ItemGroup>

  <!-- Source generators -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
  </ItemGroup>

  <!-- SourceLink — debuggable NuGet packages -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.401" />
  </ItemGroup>

  <!-- Analyzers — Layer 1: API Protection -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
  </ItemGroup>

  <!-- Analyzers — Layer 2: Compile-Time Bug Detection -->
  <ItemGroup>
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.302" />
    <PackageVersion Include="IDisposableAnalyzers" Version="4.0.8" />
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.7.23" />
    <PackageVersion Include="xunit.analyzers" Version="2.1.0" />
    <PackageVersion Include="NSubstitute.Analyzers.CSharp" Version="1.0.17" />
  </ItemGroup>

  <!-- Test dependencies -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="FluentAssertions" Version="7.2.2" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Testcontainers" Version="4.16.0" />
    <!-- Test-only HTTP substrate for the VoiceAi provider suites whose transport is HTTP
         request/response (ADR-0041 D1/D7). Referenced ONLY from
         Tests/Verbara.Sdk.TestInfrastructure.Http — NOT from Tests/Verbara.Sdk.TestInfrastructure,
         and that distinction is load-bearing: WireMock pulls ASP.NET Core, so any referencing
         project gains a FrameworkReference to Microsoft.AspNetCore.App, the ~30
         Microsoft.Extensions.* assemblies stop being copied to the output directory, and coverlet's
         Cecil resolver then silently skips instrumenting every module that needs them. Reaching
         FunctionalTests/IntegrationTests that way dropped measured coverage 80.42% -> 61.96% with
         every test still green. No src/** project references it and no produced .nupkg declares it.
         Apache-2.0 — clears dependency-review's AGPL/GPL/SSPL deny-list. The full metapackage is
         deliberate over WireMock.Net.Minimal: "Minimal" pulls OpenApiParser/NSwag and resolves
         Newtonsoft.Json 9.0.1 and System.Text.Encodings.Web 4.7.1, both carrying advisories that
         would trip dependency-review's fail-on-severity: high. -->
    <PackageVersion Include="WireMock.Net" Version="2.18.0" />
  </ItemGroup>

  <!-- Benchmark dependencies -->
  <ItemGroup>
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

</Project>
