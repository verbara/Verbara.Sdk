<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- <clear /> stops user-level / system NuGet.Config sources from leaking
         into this build (e.g. internal feeds with credentials). Matches the
         convention already used by Verbara.Sdk.Pro and Verbara.Platform and
         avoids NU1507 when central package management is on.
         The MIT SDK is normally the producer of the cross-repo local feed,
         but since ADR-0022 Phase D (Verbara.Sdk.Dapper.Stubs canary adoption
         in Sessions.Postgres) it ALSO consumes from the local feed to pull
         its own packed stubs. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local" value="/media/Data/Source/Verbara/local-nuget-feed/" />
  </packageSources>
</configuration>
