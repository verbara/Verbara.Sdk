<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- <clear /> stops user-level / system NuGet.Config sources from leaking
         into this build (e.g. internal feeds with credentials). Matches the
         convention already used by Verbara.Sdk.Pro and Verbara.Platform and
         avoids NU1507 when central package management is on.
         The MIT SDK is the PRODUCER of the cross-repo local feed, not a consumer:
         every Verbara.Sdk.* sibling is referenced via ProjectReference (incl.
         Verbara.Sdk.Data.Npgsql since ADR-0022 Phase D), so nuget.org is the only
         source needed and CI publish (publish.yml) restores cleanly without the
         maintainer-only local feed path. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
