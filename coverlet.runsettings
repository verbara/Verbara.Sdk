<?xml version="1.0" encoding="utf-8"?>
<!--
  Coverage collection settings for the CI coverage-ratchet job.
  Measures only the production code the CI unit job actually exercises: excludes
  test assemblies, generated code (carries [GeneratedCode]), SQL migrations, AND
  the src assemblies whose ONLY tests are container-backed (Testcontainers) — those
  are excluded from the unit subset, so counting them at 0% would dilute the number
  and mask real regressions. See docs/research/2026-06-14-sdk-coverage-baseline.md.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <Exclude>[*.Tests]*,[*.Tests.*]*,[*.TestInfrastructure]*,[*.TestInfrastructure.Http]*,[*.Benchmarks]*,[Verbara.Sdk.Cluster.Postgres]*,[Verbara.Sdk.Sessions.Postgres]*,[Verbara.Sdk.Sessions.Redis]*</Exclude>
          <ExcludeByFile>**/Migrations/*.cs</ExcludeByFile>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
